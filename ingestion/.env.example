# Ingestion environment — copy from project root .env.example
OPENAI_API_KEY=sk-...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

INGEST_START_PERIOD=2024Q1
INGEST_END_PERIOD=2025Q1
INGEST_TICKERS=AAPL,MSFT,GOOGL,GOOG,AMZN,META,NVDA,TSLA
MAX_TRANSCRIPTS=
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
CLEANUP_TEMP_FILES=true
EMBEDDING_BATCH_SIZE=100
UPLOAD_BATCH_SIZE=10
PAUSE_BETWEEN_TRANSCRIPTS_SECONDS=3
MIN_CHUNKS_TO_SKIP=15
DROP_VECTOR_INDEX_ON_START=true
REBUILD_VECTOR_INDEX_ON_FINISH=false
